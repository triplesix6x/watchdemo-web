{
  "name": "watchdemo-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:mock": "tsc && vite build --mode mock && vite build --ssr src/entry-server.tsx --outDir dist-ssr --mode mock && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "og": "node scripts/og.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@fontsource/onest": "^5.3.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "axe-core": "^4.14.0",
    "playwright-core": "1.59",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "type": "module"
}
